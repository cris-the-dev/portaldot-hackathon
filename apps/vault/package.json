{
  "name": "@portalkit/vault-app",
  "version": "0.0.0",
  "private": true,
  "description": "PortalVault — tokenized RWA vault (ERC-4626) showcase built with PortalKit",
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync-contracts.mjs",
    "predev": "node scripts/sync-contracts.mjs",
    "dev": "next dev --port 3001",
    "prebuild": "node scripts/sync-contracts.mjs",
    "build": "next build",
    "start": "next start --port 3001",
    "lint": "eslint src test",
    "typecheck": "next typegen && tsc -p tsconfig.json",
    "test": "vitest run",
    "e2e": "node e2e/smoke.mjs"
  },
  "dependencies": {
    "@portalkit/chains": "workspace:*",
    "@tanstack/react-query": "^5.104.0",
    "next": "^16.3.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "viem": "^2.57.0",
    "wagmi": "^3.7.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright-core": "1.63.0",
    "tailwindcss": "^4.3.3",
    "vitest": "^5.0.2"
  }
}
