{
  "name": "@portalkit/chains",
  "version": "0.0.0",
  "description": "viem/wagmi chain definitions for Portaldot, loaded from config/networks.json",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "viem": "^2.57.0",
    "zod": "^4.6.5"
  }
}
